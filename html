<div class="diabetes-system" dir="rtl">
    <h2>نظام توقع مرض السكري</h2>
    <p>إعداد: المهندسة ندى</p>

    <div class="container">
        <div class="input-group">
            <label>BMI مؤشر الكتلة</label>
            <input type="number" step="0.01" placeholder="أدخل النتيجة هنا...">
        </div>

        <div class="input-group">
            <label>نسبة الكوليسترول</label>
            <input type="number" placeholder="0">
        </div>

        <div class="input-group">
            <label>تاريخ العائلة</label>
            <input type="number" step="0.01" placeholder="0.00">
        </div>

        <div class="input-group">
            <label>النشاط البدني</label>
            <input type="number" placeholder="0">
        </div>

        <div class="input-group">
            <label>عدد مرات الحمل</label>
            <input type="number" placeholder="0">
        </div>

        <div class="input-group">
            <label>التدخين (0 أو 1)</label>
            <select>
                <option value="0">0 (غير مدخن)</option>
                <option value="1">1 (مدخن)</option>
            </select>
        </div>
    </div>
    
    <button class="predict-btn">تحليل النتائج</button>
</div>
